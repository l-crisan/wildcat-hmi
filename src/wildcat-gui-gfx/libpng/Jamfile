SubDir TOP src wildcat-gui-gfx libpng ;

SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libpng ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libz/include ;

SubDirObjects $(WILDCAT_OUTPUT_OBJECT) libpng ;

SubDirCcFlags [ FDefines _CRT_SECURE_NO_WARNINGS ] ;

SubDirCcFlags [ FDefines PNG_ARM_NEON_OPT=0 ] ;

Library png : png.c
              pngerror.c
              pngget.c
              pngmem.c
              pngpread.c
              pngread.c
              pngrio.c
              pngrtran.c
              pngrutil.c
              pngset.c
              pngtrans.c
              pngwio.c
              pngwrite.c
              pngwtran.c
              pngwutil.c ;

MakeLocate png : $(WILDCAT_OUTPUT_TARGET) ;
