                           ;

LinkLibs wildcat-gui-gfx : $(WILDCAT_HMI_LINKLIBS) ;

LinkSharedLibraries wildcat-gui-gfx : wildcat-gui-base ;

LinkLibraries wildcat-gui-gfx : zlib png jpeg freetype ;
MakeLocate wildcat-gui-gfx : $(WILDCAT_OUTPUT_TARGET) ;


SubInclude TOP src wildcat-gui-gfx freetype src ;

SubInclude TOP src wildcat-gui-gfx libjpeg ;

SubInclude TOP src wildcat-gui-gfx libpng ;

SubInclude TOP src wildcat-gui-gfx libz ;