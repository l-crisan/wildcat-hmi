SubDir TOP src wildcat-gui-gfx ;

SubDirC++Flags [ FDefines WILDCAT_GUI_GFX_API_EXPORT ] ;


SubDirHdrs $(TOP)/include ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/freetype/include ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libpng ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libjpeg ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libz/include ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libxpm/include/X11 ;
SubDirHdrs $(TOP)/src/wildcat-gui-gfx/libxpm/src/ ;
SubDirObjects $(WILDCAT_OUTPUT_OBJECT) wildcat-gui-gfx ;

