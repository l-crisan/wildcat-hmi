#############################################################################
# GUI libraries and includes
#############################################################################

if --with-x11 in $(ARGV)
{
    GUI ?= x11 ;
}
if --with-x11-raster in $(ARGV)
{
    GUI ?= x11 ;
}
else if --with-x11-core in $(ARGV)
{
    GUI ?= x11 ;
}
else if --with-win32-gdi in $(ARGV)
{
    GUI ?= win32 ;
}
else if --with-win32-raster in $(ARGV)
{
    GUI ?= win32 ;
}
else if --with-sdl-raster in $(ARGV)
{
    GUI ?= sdl ;
}
else if --with-photon in $(ARGV)
{
    GUI ?= photon ;
}

if ! $(GUI) || $(GUI:L) = "win32"
{
    Load winui.jam ;

    ConfigureWinUI ;
    ConfigureGdi ;

    if $(WITH_GDI) && $(WITH_WINUI)
    {
        GUI ?= win32 ;
        GUILIBS = $(GDI_LIBS) $(WINUI_LIBS) ;
    }
    
    if $(GUI)
    {
        if --with-win32-raster in $(ARGV)
        {
            WILDCAT_GUI_IMPL = win32-raster ;
        }
        else
        {
            WILDCAT_GUI_IMPL = win32-gdi ;
        }
    }
}

if ! $(GUI) || $(GUI):L = "cocoa"
{
    WITH_GUI = [ CheckBuildC++ "#include <CoreFoundation/CFRunLoop.h>"
                               "int main() {"
                               "CFRunLoopRef l = CFRunLoopGetMain();"
                               "return 0; }"
                             : ""
                             : -framework AppKit -framework Foundation ] ;

    if $(WITH_GUI)
    {
        GUI = cocoa ;
        GUILIBS = -framework AppKit -framework Foundation ;
    }

    # iOS aspen:
    #GUI     ?= uikit ;
    #GUILIBS = -framework UIKit -framework Foundation -framework CoreGraphics ;
    
    if $(GUI)
    {
        WILDCAT_GUI_IMPL = cocoa ;
    }
}

if ! $(GUI) || $(GUI:L) = "linux-fb"
{
    WITH_GUI = [ CheckBuildC++ "#include <linux/fb.h>"
                               "int main() {"
                               "struct fb_var_screeninfo si;"
                               "return 0; }"
                             : ""
                             : "" ] ;

    if $(WITH_GUI)
    {
        GUI = linux-fb ;
    }
    
    if $(GUI)
    {
        WILDCAT_GUI_IMPL = linux-fb ;

        Load simd.jam ;
        
        if $(WITH_CPU_NEON)
        {
            PT_FORMS_C++FLAGS += [ FDefines PT_FORMS_WITH_CPU_NEON ] ;
            PT_FORMS_C++FLAGS += $(CPU_NEON_C++FLAGS) ;
        }
    }
}

if ! $(GUI) || $(GUI:L) = "x11"
{
    Load x11.jam ;

    ConfigureX11 ;

    if $(X11_LIBS)
    {
        ConfigureXExt ;
        ConfigureXft ;

        if $(X11_INCLUDES) && $(X11_LIBS) && $(XEXT_LIBS) && $(XFT_INCLUDES) && $(XFT_LIBS)
        {
            GUI ?= x11 ;
            GUILIBS += $(X11_LIBS) $(XEXT_LIBS) $(XFT_LIBS) -lXcursor ;
        }
    }

    if $(GUI)
    {
        if --with-x11-core in $(ARGV)
        {
            WILDCAT_GUI_IMPL = x11-core ;
        }
        else
        {
            WILDCAT_GUI_IMPL = x11-raster ;
        }
    }
}

if $(GUI:L) = "sdl"
{
    WILDCAT_GUI_IMPL = sdl ;
}

if $(GUI:L) = "photon"
{
    WILDCAT_GUI_IMPL = photon ;
    GUILIBS = -lphrender -lph ;
}

WILDCAT_HMI_LINKLIBS += $(GUILIBS) $(NETLIBS) ; 

Configure WILDCAT_HMI_LINKLIBS ;

Configure GUI ;
EchoOption GUI : "UI platform" : $(GUI:E="none") ;

if $(GUI)
{
    Configure WILDCAT_GUI_IMPL ;
    EchoOption WILDCAT_GUI_IMPL : "UI implementation" ;

    Configure GUILIBS ;
    EchoOption GUILIBS : "UI platform linklibs" ;

    Configure WILDCAT_GUI_C++FLAGS ;
    EchoOption WILDCAT_GUI_C++FLAGS : "UI platform C++ flags" ;
}
