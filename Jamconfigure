# fallback to POSIX
WILDCAT_SYSTEM ?= posix ;

#
# Configuration for win32 systems
#

if $(WILDCAT_SYSTEM) = win32
{
    PSAPI_LINKLIBS ?= Psapi.lib ;

    WITH_PSAPI = [ CheckBuildC++ "#include <windows.h>"
                                 "#include <Psapi.h>"
                                 "int main() { PROCESS_MEMORY_COUNTERS pmc;"
                                 "GetProcessMemoryInfo( NULL, &pmc, sizeof(pmc) );"
                                 "return 0; }"
                                 : ""
                                 : $(PSAPI_LINKLIBS) ] ;

    if ! $(WITH_PSAPI)
    {
        PSAPI_LINKLIBS = -lPsapi ;

        WITH_PSAPI = [ CheckBuildC++ "#include <windows.h>"
                                        "#include <Psapi.h>"
                                        "int main() { PROCESS_MEMORY_COUNTERS pmc;"
                                        "GetProcessMemoryInfo( NULL, &pmc, sizeof(pmc) );"
                                        "return 0; }"
                                        : ""
                                        : $(PSAPI_LINKLIBS) ] ;
    }

    EchoOption PSAPI_LINKLIBS : "Psapi libs" ;
    WILDCAT_SYSTEM_LINKLIBS += $(PSAPI_LINKLIBS) ;
    WILDCAT_HMI_LINKLIBS = /LIBPATH:$(WILDCAT_LIBDIR) Winmm.lib Iphlpapi.lib Advapi32.lib Dbghelp.lib Ws2_32.lib dwmapi.lib Pt.lib Pt-System.lib gdi32.lib Msimg32.lib user32.lib ole32.lib ;
}

#
# Configuration for POSIX systems
#

if $(WILDCAT_SYSTEM) = posix
{
    #
    # System realtime clock
    #

    # Linux can link programs without -lrt, but needs it to run

    POSIX_CLOCK_LINKLIBS ?= -lrt ;

    WITH_POSIX_CLOCK = [ CheckBuildC++ "#include <time.h>"
                                       "#include <sys/time.h>"
                                       "int main() { timespec tp;"
                                       "clock_gettime(CLOCK_MONOTONIC, &tp);"
                                       "return 0; }"
                                       : ""
                                       : $(POSIX_CLOCK_LINKLIBS) ] ;

    if ! $(WITH_POSIX_CLOCK)
    {
        POSIX_CLOCK_LINKLIBS = "" ;

        WITH_POSIX_CLOCK = [ CheckBuildC++ "#include <time.h>"
                                           "#include <sys/time.h>"
                                           "int main() { timespec tp;"
                                           "clock_gettime(CLOCK_MONOTONIC, &tp);"
                                           "return 0; }"
                                           : ""
                                           : -lc ] ;
    }

    if ! $(WITH_POSIX_CLOCK)
    {
        POSIX_CLOCK_LINKLIBS = "" ;

        WITH_MACH_CLOCK = [ CheckBuildC++ "#include <mach/mach_time.h>"
                                          "int main() { mach_absolute_time(); return 0; }"
                                          : ""
                                          : "" ] ;
    }

    EchoOption POSIX_CLOCK_LINKLIBS : "Realtime clock libs" ;

    if $(WITH_MACH_CLOCK)
    {
        EchoOption WITH_MACH_CLOCK : "Mach clock" : $(WITH_MACH_CLOCK:E="no") ;
        Configure WITH_MACH_CLOCK ;
    }
    else if $(WITH_POSIX_CLOCK)
    {
        EchoOption WITH_POSIX_CLOCK : "POSIX clock" : $(WITH_POSIX_CLOCK:E="no") ;
        Configure WITH_POSIX_CLOCK ;
    }
    else
    {
        Exit "Error: clocks are required." ;
    }

    #
    # dynamic library loader
    #

    WITH_DL = [ CheckBuildC++ "#include <dlfcn.h>"
                              "int main() { dlopen(0,0); return 0; }"
                              : ""
                              : -lc ] ;

    if ! $(WITH_DL)
    {
        DL_LINKLIBS = -ldl ;

        WITH_DL = [ CheckBuildC++ "#include <dlfcn.h>"
                                  "int main() { dlopen(0,0); return 0; }"
                                  : ""
                                  : $(DL_LINKLIBS) ] ;
    }

    EchoOption DL_LINKLIBS : "Dl libs" ;

    if ! $(WITH_DL)
    {
        Exit "Error: dl is required." ;
    }

    #
    # POSIX threads
    #

    WITH_PTHREADS = [ CheckBuildC++ "#include <pthread.h>"
                                    "int main() { pthread_t id; void* p;"
                                    "pthread_join(id, &p); return 0; }"
                                    : ""
                                    : -lc ] ;

    if ! $(WITH_PTHREADS)
    {
        PTHREAD_LINKLIBS = -lpthread ;

        WITH_PTHREADS = [ CheckBuildC++ "#include <pthread.h>"
                                        "int main() { pthread_t id; void* p;"
                                        "pthread_join(id, &p); return 0; }"
                                        : ""
                                        : $(PTHREAD_LINKLIBS) ] ;
    }

    EchoOption PTHREAD_LINKLIBS : "Pthread libs" ;

    if ! $(WITH_PTHREADS)
    {
        Exit "Error: pthread is required." ;
    }

    #
    # POSIX math
    #

    WITH_M = [ CheckBuildC++ "#include <math.h>"
                             "int main() { return (int) sin(42); }"
                             : "" : -lc ] ;
    if ! $(WITH_M)
    {
        M_LINKLIBS = -lm ;

        WITH_M = [ CheckBuildC++ "#include <math.h>"
                                 "int main() { return (int) sin(42); }"
                                 : "" : $(M_LINKLIBS) ] ;
    }

    EchoOption M_LINKLIBS : "Math libs" ;

    WILDCAT_SYSTEM_LINKLIBS +=  $(POSIX_CLOCK_LINKLIBS) $(PTHREAD_LINKLIBS) $(DL_LINKLIBS) ;

    WILDCAT_HMI_LINKLIBS = -L$(WILDCAT_LIBDIR) -L$(WILDCAT_SYSROOTDIR) -lrt  -lPt -lPt-System ;
}



if $(TARGET_OS) = "aix"
{
    LINKLIBS += $(WILDCAT_SYSTEM_LINKLIBS) ;
}


EchoOption WILDCAT_SYSTEM : "System abstraction" ;
Configure WILDCAT_SYSTEM ;

Configure WILDCAT_SYSTEM_LINKLIBS ;
