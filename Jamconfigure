if --with-qt5 in $(ARGV)
{
    QT5_SUPPORT = yes ;
}

if $(QT5_SUPPORT)
{
	QT5_LIBS = Qt5Core Qt5Widgets Qt5Gui ;
	QT_LIBS = QtCore QtWidgets QtGui ;

	if $(QTDIR)
	{
		QT_INCLUDES ?= [ FDirName $(QTDIR) include ] ;
		QT_LIBDIR ?= [ FDirName $(QTDIR) lib ] ;
	}

	QT_LINKLIBS ?= -l$(QT5_LIBS) ;
	QT_LINKFLAGS ?= -L$(QT_LIBDIR) ;

	WITH_QT = [ CheckBuildC++ "#include <QtCore/QString>"
							  "int main() { QString qs; return 0; }"
							: [ FIncludes $(QT_INCLUDES) ] $(QT_C++FLAGS)
							: $(QT_LINKLIBS) $(QT_LINKFLAGS) ] ;

	if ! $(WITH_QT)
	{
		QT_C++FLAGS = -F$(QT_LIBDIR) ;
		QT_LINKLIBS = "-framework "$(QT_LIBS) ;
		QT_LINKFLAGS = -F$(QT_LIBDIR) ;

		WITH_QT = [ CheckBuildC++ "#include <QtCore/QString>"
								  "int main() { QString qs; return 0; }"
								: [ FIncludes $(QT_INCLUDES) ] $(QT_C++FLAGS)
								: $(QT_LINKLIBS) $(QT_LINKFLAGS) ] ;
	}

	if ! $(WITH_QT)
	{
		if $(WITH_DEBUG) && ! $(WITH_OPTIM)
		{
			QT_SUFLIB = d.lib ;
		}

		QT_C++FLAGS = ;
		QT_LINKLIBS = $(QT5_LIBS:S=$(QT_SUFLIB:E=".lib")) ;
		QT_LINKFLAGS = /LIBPATH:$(QT_LIBDIR) ;

		WITH_QT = [ CheckBuildC++ "#include <QtCore/QString>"
								  "int main() { QString qs; return 0; }"
								: [ FIncludes $(QT_INCLUDES) ] $(QT_C++FLAGS)
								: $(QT_LINKLIBS) $(QT_LINKFLAGS) ] ;
	}
}

EchoOption --with-qt5 : "Qt support" : $(QT5_SUPPORT:E="no") ;

